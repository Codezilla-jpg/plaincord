Screen {
    background: #0d0f12;
    color: #e8eaed;
}

Header {
    background: #0d0f12;
    color: #e8eaed;
    text-style: none;
}

Footer {
    background: #0d0f12;
    color: #8b929c;
}

#body {
    height: 1fr;
}

#guilds {
    width: 22;
    background: #12151a;
    border-right: tall #242a32;
    scrollbar-gutter: stable;
}

#channels {
    width: 28;
    background: #14181e;
    border-right: tall #242a32;
    scrollbar-gutter: stable;
}

#main {
    width: 1fr;
    background: #0d0f12;
}

#chat-title {
    height: 3;
    padding: 1 2;
    color: #e8eaed;
    text-style: bold;
    background: #0d0f12;
    border-bottom: tall #242a32;
}

#chat {
    height: 1fr;
    padding: 1 2;
    background: #0d0f12;
    scrollbar-gutter: stable;
}

#composer {
    margin: 0 1 1 1;
    background: #161b22;
    border: tall #242a32;
    color: #e8eaed;
}

#composer:focus {
    border: tall #7aa2f7;
}

#voicebar {
    dock: bottom;
    height: 1;
    padding: 0 2;
    background: #12151a;
    color: #8b929c;
}

ListView > ListItem {
    padding: 0 1;
    background: #12151a;
    color: #c9cdd3;
}

ListView > ListItem.--highlight {
    background: #1e2530;
    color: #e8eaed;
}

Tree {
    background: #14181e;
    padding: 1 0;
}

LoginScreen {
    align: center middle;
    background: #0d0f12;
}

#login-box {
    width: 64;
    height: auto;
    padding: 2 3;
    background: #14181e;
    border: tall #242a32;
}

#login-title {
    text-style: bold;
    color: #e8eaed;
    margin-bottom: 1;
}

#login-hint {
    color: #8b929c;
    margin-bottom: 1;
}

#token {
    margin-top: 1;
    background: #0d0f12;
    border: tall #242a32;
}

#token:focus {
    border: tall #7aa2f7;
}

InviteModal {
    align: center middle;
}

#invite {
    width: 80;
    height: auto;
    padding: 2 3;
    background: #14181e;
    border: tall #242a32;
}

#invite-url {
    margin: 1 0;
    color: #7aa2f7;
}

#invite-hint {
    color: #8b929c;
}
